# Local container settings; port 3307 avoids an existing MySQL installation on 3306.
MYSQL_PORT=3307
MYSQL_PASSWORD=replace_with_app_password
MYSQL_ROOT_PASSWORD=replace_with_root_password
DATABASE_URL=mysql://quintle:replace_with_app_password@127.0.0.1:3307/quintle
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
