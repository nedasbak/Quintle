{
  "name": "@quintle/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "build": "tsc --noEmit --strict --allowJs --module nodenext --moduleResolution nodenext --target es2024 --allowImportingTsExtensions src/server.ts",
    "test": "node --test tests/scoring.test.ts tests/api.test.ts tests/themes.test.ts tests/frontend.test.ts tests/answerMatching.test.ts",
    "test:integration": "node tests/runMysqlTests.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "mysql2": "^3.24.6"
  }
}
